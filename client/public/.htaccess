<IfModule mod_headers.c>
  # Never let browsers/proxies cache the HTML shell, so a reload always
  # picks up the latest build's asset filenames.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # Vite fingerprints JS/CSS/asset filenames per build, so these are safe
  # to cache forever — a new build gets a new filename automatically.
  <FilesMatch "\.(js|css|woff2?|ttf|eot|svg|png|jpe?g|gif|webp|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
